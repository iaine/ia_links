{
  "manifest_version": 3,
  "name": "IA Link Ripper",
  "version": "0.0.2",
  "description": "Pull Wayback Machine (Internet Archive CDX) snapshot links for one or more URLs, and export as text, CSV, or an HTML links page.",
  "author": "CIM",

  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://web.archive.org/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "IA Link Ripper"
  },

  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "ia-link-ripper@warwick.ac.uk",
      "strict_min_version": "109.0"
    }
  }
}
